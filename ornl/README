# fathom3m HUC8 12090205
# change ornl/fim_run.sh: 
#   export input_WBD_gdb=$inputDataDir/wbd/WBD_National.gpkg
# change src/run_by_unit.sh: 
#   input_DEM=/home/yxl/test/fim3/tmp/12090205_fathom3m.tif # for fathom3m DEM test
mkdir /dev/shm/fim3
nohup ./fim_run.sh -u 12090205 -c ./params_calibrated.env -n 12090205 -e FR >/dev/shm/fim3/12090205.log 2>&1 &
nohup ./fim_run.sh -u 12040201 -c ./params_calibrated.env -n 12040201 -e FR >/dev/shm/fim3/12040201.log 2>&1 &

# tnris1m HUC12 120902050305
# DEM reprojection
cd /home/yxl/test/fim3
gdalwarp -of GTiff -co "BIGTIFF=YES" -t_srs epsg:5070 -r cubic tnris_stratmap-2017-50cm-central-texas_120902050305_buf5km.vrt tnris_stratmap-2017-50cm-central-texas_120902050305_buf5km_epsg5070.tif
# WBD: add included_huc12.lst to /home/yxl/test/fim3/inputs/huc_lists/
# WBD: use my WBD gpkg format (fiona doesn't handle filegdb) to include HUC12
/srv/data/wbd/WBD
ogr2ogr -t_srs epsg:5070 -f GPKG WBD.gpkg WBD.gdb WBDHU2 WBDHU4 WBDHU6 WBDHU8 WBDHU10 WBDHU12
# change ornl/fim_run.sh: 
#   export input_WBD_gdb=/srv/data/wbd/WBD/WBD.gpkg
# change src/run_by_unit.sh: 
#   input_DEM=/home/yxl/test/fim3/tnris_stratmap-2017-50cm-central-texas_120902050305_buf5km_epsg5070.tif # for tnris1m DEM test
nohup ./fim_run.sh -u 120902050305 -c ./params_calibrated.env.1m_120902050305 -n 120902050305 -e FR >/dev/shm/fim3/1m_120902050305.log 2>&1 &

# fathom3m data prep
for f in n30w99 n30w98 n29w99 n29w98 ; do echo "/home/yxl/data/fathom3m/dem/$f.tif"; done>12090205.filelist
gdalbuildvrt -input_file_list 12090205.filelist 12090205.vrt
gdalwarp -of GTiff -co "COMPRESS=LZW" -co "BIGTIFF=YES" -co "TILED=YES" -t_srs epsg:5070 -r cubic ./12090205.vrt 12090205_fathom3m.tif

# utility commands
### convert to FileGDB
ogr2ogr -f FileGDB 12090205_floodstack_1_80_1.gdb 12090205_floodstack_1_80_1.shp -nln floodextent -mapFieldType Integer64=Integer

# check errors in log, after zip is produced
cd /srv/test/cahaba/ornl/logs/region6
for z in `ls /home/yxl/test/fim3/region6`; do h=`basename $z .zip`; a=`grep "Maximum TIFF file size exceeded" $h.log`; b=`grep "Exit status: 1" $h.log`; [ ! -z "$a" ] && echo "$h BIGTIFF issue"; [ ! -z "$b" ] && echo "h exit error"; done

# inundation tool:
python ../tools/inundation.py -r $datadir/$h/rem_zeroed_masked.tif -c $datadir/$h/gw_catchments_reaches_filtered_addedAttributes.tif -b $datadir/$h/gw_catchments_reaches_filtered_addedAttributes_crosswalked.gpkg -t $datadir/$h/hydroTable.csv -f $datadir/o/$h/test_forecast.csv -i $datadir/o/$h/inun_bin.tif -p $datadir/o/$h/inun_bin.gpkg -d $datadir/o/$h/inun_depth.tif
